/* Profile Image Styling */
.profile-frame {
   
    margin: 0 auto 15px;
    border-radius: 50%;
    padding: 5px;
    background: linear-gradient(45deg, var(--neon-purple), var(--neon-orange));
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-pic {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: #1a1a1a;
    border: 3px solid #0a0a0c;
}

/* Text Styling */
.member-name {
    color: var(--text-main);
    font-size: 1.1rem;
    margin: 10px 0 5px;
}

.member-post {
    color: var(--neon-orange);
    font-weight: bold;
    font-size: 0.9rem;
    margin-bottom: 5px;
}

.member-dept {
    color: var(--text-dim);
    font-size: 0.8rem;
}

    
   