/* Header Layout */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}



/* Header Layout */
.navbar {
    position: fixed;    /* CHANGED: Fixes the header to the viewport */
    top: 0;             /* ADDED: Pins it to the very top */
    left: 0;            /* ADDED: Pins it to the left */
    width: 100%;        /* ADDED: Ensures it spans the full width */
    box-sizing: border-box; /* ADDED: Keeps padding from pushing the width over 100% */
    
    display: flex;
    justify-content: space-between; 
    align-items: center;
    padding: 20px 20px;
    z-index: 100;       /* INCREASED: Ensures it stays above all content and video */
    
    /* Optional: Add a background or blur so content doesn't make text hard to read as it scrolls under */
    background: rgba(0, 0, 0, 0.6); 
    backdrop-filter: blur(10px); 
}










.nav-links {
        display: none; /* Hide default nav */
        flex-direction: column;
        position: absolute;
        top: 100%;
        right: 0;
        background: rgb(0, 0, 0);
        width: 60%;
        text-align: center;
        padding: 20px 0;
    }
