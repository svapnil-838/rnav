/* Team Section Styling 1 */



.team-section {
    padding: 10px 10px;
    background-color: #0a0a0c00; /* Deep dark background */
    font-family: 'Segoe UI', Roboto, sans-serif;
}

.section-title {
    text-align: center;
    color: var(--text-main);
    margin-bottom: 40px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* Responsive Grid Logic */
.team-grid {
    display: grid;
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
    /* Default: 2 columns for mobile/tablet */
    grid-template-columns: repeat(2, 1fr);
}

/* 4 columns for desktop */
@media (min-width: 1024px) {
    .team-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

/* Team Card Styling */
.team-card {
    background: var(--glass-bg);
    border: 1px solid rgba(255, 255, 255, 0.509);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    /* Neon border effect on the sides similar to your image */
    box-shadow: inset 0 0 15px rgb(157, 80, 187);
}

.team-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 3px; height: 100%;
    background: linear-gradient(to bottom, var(--neon-purple), transparent);
}

